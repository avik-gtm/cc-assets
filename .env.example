# Protects POST /api/assets. Leave blank only during local development.
ASSET_API_KEY=

# Public origin used when the API returns an asset URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for durable asset storage on Vercel.
BLOB_READ_WRITE_TOKEN=

# Optional external-service route for new-company generation.
# Accepts {systemPrompt, input, outputSchema}; returns GeneratedAsset JSON.
ASSET_GENERATOR_URL=
ASSET_GENERATOR_TOKEN=

# Alternative: write directly through Vercel AI Gateway using deployment OIDC.
# Select a current structured-output model ID from /v1/models.
AI_GATEWAY_MODEL=
# Only needed outside Vercel/OIDC; never expose to the browser.
AI_GATEWAY_API_KEY=
# Linked Blob store can use OIDC instead of a read-write token.
BLOB_STORE_ID=
