# Protects POST /api/assets. Leave blank only during local development.
ASSET_API_KEY=

# Public origin used when the API returns an asset URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for durable asset storage on Vercel.
BLOB_READ_WRITE_TOKEN=

# Separate content generator. Vercel hosts pages/API/storage only.
# Accepts {systemPrompt, input, outputSchema}; returns GeneratedAsset JSON.
ASSET_GENERATOR_URL=
# Required on hosted deployments. Never expose to the browser.
ASSET_GENERATOR_TOKEN=
# Linked Blob store can use OIDC instead of a read-write token.
BLOB_STORE_ID=
