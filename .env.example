# Protects POST /api/assets. Leave blank only during local development.
ASSET_API_KEY=

# Public origin used when the API returns an asset URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for durable asset storage on Vercel.
BLOB_READ_WRITE_TOKEN=

# Optional future agent service. It must accept GenerationInput JSON and return
# an AssetDocument matching src/lib/schemas.ts.
ASSET_GENERATOR_URL=
ASSET_GENERATOR_TOKEN=
